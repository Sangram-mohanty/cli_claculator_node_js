PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/family_tree
CLIENT_ORIGIN=http://localhost:4200
UPLOAD_DIR=uploads
# Password for the admin, who is the only one allowed to delete people or family trees.
# Deleting stays turned off until this is set.
ADMIN_PASSWORD=
# Optional: a long random string so admin sign-ins survive API restarts.
ADMIN_TOKEN_SECRET=
